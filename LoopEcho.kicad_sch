	(text "Only the repeats circulate: the first echo is clean, each later echo goes through the loop again."
		(exclude_from_sim no)
		(at 320.04 365.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c14073ac-47d7-4bd8-9072-a7b4dbb0237e")
	)
	(text "A fuzz in the loop adds gain every pass: the 1N4148s cap the loop at about +-0.6 V so oscillation stays musical."
		(exclude_from_sim no)
		(at 320.04 373.38 0)
		(effects
			(font
				(size 1.27 1.27)
